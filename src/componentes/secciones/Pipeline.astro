---
import { Image } from "astro:assets";
import GrillaPuntos from "../islas/GrillaPuntos.astro";
import fotoReconocimiento from "../../assets/mockup-reconocimiento-facial.webp";
import fotoAsistencia from "../../assets/mockup-asistencia.webp";
import fotoWhatsapp from "../../assets/mockup-whatsapp.webp";
import type { Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);

// Los 3 pasos usan capturas reales en vez de íconos — cualquier dato
// sensible desenfocado o ya anonimizado en origen (ver historial de esta
// sección). Cada una mantiene su proporción real (nada de recortes
// forzados a cuadrado): la 1 es vertical, la 2 y la 3 horizontales. Para
// que las 3 cards queden del mismo alto pese a tener ratios distintos,
// el contenedor fija el alto (ver .card-media abajo) y el ancho sale
// solo del aspect-ratio — no al revés.
const capturas = [
  { src: fotoReconocimiento, ancho: 1792, alto: 2400 },
  { src: fotoAsistencia, ancho: 1200, alto: 555 },
  { src: fotoWhatsapp, ancho: 1000, alto: 562 },
];
---

<section id="pipeline" class="relative border-b border-[var(--linea)] py-24 md:py-32">
  <GrillaPuntos opacidad={0.3} />

  <div class="contenedor relative z-10">
    <header class="max-w-xl">
      <p class="etiqueta text-humo">{t.pipeline.eyebrow}</p>
      <h2 class="mt-5 text-titulo-sm text-escarcha md:text-titulo">{t.pipeline.titulo}</h2>
    </header>

    <div class="mt-14">
      {
        t.pipeline.pasos.map((paso, indice) => {
          const captura = capturas[indice]!;
          return (
            <div
              class="tarjeta-apilable"
              style={`top: ${4 + indice * 1}rem; z-index: ${indice + 1};`}
            >
              <div class="grid h-full items-center gap-8 rounded-2xl border border-[var(--linea)] bg-carbon p-8 md:grid-cols-[1fr_1.4fr] md:gap-12 md:p-12">
                <div
                  class="mx-auto h-44 max-w-full overflow-hidden rounded-xl border border-[var(--linea)] md:h-52"
                  style={`aspect-ratio: ${captura.ancho} / ${captura.alto};`}
                >
                  <Image
                    src={captura.src}
                    alt=""
                    aria-hidden="true"
                    width={captura.ancho}
                    height={captura.alto}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div>
                  <p class="cifra text-leyenda text-lima">{String(indice + 1).padStart(2, "0")} / 03</p>
                  <p class="mt-3 text-titulo-sm text-escarcha">{paso.titulo}</p>
                  <p class="mt-4 max-w-md text-cuerpo text-ceniza">{paso.detalle}</p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
