---
import GrillaPuntos from "../islas/GrillaPuntos.astro";
import type { Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);

/** Iconos lineales mínimos, uno por paso — currentColor para heredar el tema. */
const iconos = [
  // Cámara: reconocimiento facial.
  `<rect x="8" y="20" width="48" height="32" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
   <rect x="24" y="13" width="16" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
   <circle cx="32" cy="37" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/>
   <circle cx="32" cy="37" r="3.5" fill="currentColor"/>`,
  // Base de datos: encoding + MongoDB.
  `<ellipse cx="32" cy="16" rx="20" ry="7" fill="none" stroke="currentColor" stroke-width="1.5"/>
   <path d="M12 16v32c0 3.9 8.95 7 20 7s20-3.1 20-7V16" fill="none" stroke="currentColor" stroke-width="1.5"/>
   <path d="M12 32c0 3.9 8.95 7 20 7s20-3.1 20-7" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
  // Aviso: bot de Telegram.
  `<path d="M10 34 L54 12 L44 54 L30 40 L22 46 L22 34 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
   <path d="M30 40 L54 12" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
];
---

<section id="pipeline" class="relative border-b border-[var(--linea)] py-24 md:py-32">
  <GrillaPuntos opacidad={0.3} />

  <div class="contenedor relative z-10">
    <header class="max-w-xl">
      <p class="etiqueta text-humo">{t.pipeline.eyebrow}</p>
      <h2 class="mt-5 text-titulo-sm text-escarcha md:text-titulo">{t.pipeline.titulo}</h2>
    </header>

    <div class="mt-14">
      {
        t.pipeline.pasos.map((paso, indice) => (
          <div
            class="tarjeta-apilable"
            style={`top: ${4 + indice * 1}rem; z-index: ${indice + 1};`}
          >
            <div class="grid h-full items-center gap-8 rounded-2xl border border-[var(--linea)] bg-carbon p-8 md:grid-cols-[1fr_1.4fr] md:gap-12 md:p-12">
              <div class="mx-auto aspect-square w-full max-w-[200px] text-ceniza md:max-w-[240px]">
                <svg viewBox="0 0 64 64" aria-hidden="true" class="h-full w-full" set:html={iconos[indice]} />
              </div>
              <div>
                <p class="cifra text-leyenda text-lima">{String(indice + 1).padStart(2, "0")} / 03</p>
                <p class="mt-3 text-titulo-sm text-escarcha">{paso.titulo}</p>
                <p class="mt-4 max-w-md text-cuerpo text-ceniza">{paso.detalle}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
