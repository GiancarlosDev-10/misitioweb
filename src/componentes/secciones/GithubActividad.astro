---
import { SITIO, type Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";
import { obtenerActividadGithub, type DiaContribucion } from "../../datos/github-actividad";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);

const { dias, totalContribuciones, rachaActual, rachaMaxima, repositoriosPublicos } = await obtenerActividadGithub();

// GitHub siempre arranca el calendario en domingo y entrega semanas completas,
// así que trocear de 7 en 7 alcanza — no hace falta calcular día de semana.
const semanasCompletas: DiaContribucion[][] = [];
for (let i = 0; i < dias.length; i += 7) semanasCompletas.push(dias.slice(i, i + 7));

// Recorta a las semanas más recientes: el ancho de la columna en desktop
// (1.6fr de la tarjeta, dentro de "contenedor") entra ~44 columnas de 14px
// sin necesitar scroll. Los totales de la derecha siguen saliendo de `dias`
// completo — el recorte es solo visual, no toca ninguna cifra.
const SEMANAS_VISIBLES = 43;
const semanas = semanasCompletas.slice(-SEMANAS_VISIBLES);

const MESES =
  idioma === "en"
    ? ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    : ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

interface EtiquetaMes {
  texto: string;
  columna: number;
}

// Una etiqueta por cada mes nuevo que empieza, en la columna (semana) donde cae.
const etiquetasMes: EtiquetaMes[] = [];
let mesAnterior = -1;
semanas.forEach((semana, indice) => {
  const primerDia = semana[0];
  if (!primerDia) return;
  const mes = new Date(`${primerDia.fecha}T00:00:00Z`).getUTCMonth();
  if (mes !== mesAnterior) {
    etiquetasMes.push({ texto: MESES[mes]!, columna: indice });
    mesAnterior = mes;
  }
});

// El primer mes suele quedar partido en pocas semanas (el rango empieza a
// mitad de mes): si su etiqueta queda muy cerca de la siguiente, se
// solapan. Se conserva solo si hay espacio real, igual que hace GitHub.
const SEPARACION_MINIMA = 3;
const etiquetasVisibles: EtiquetaMes[] = [];
for (const etiqueta of etiquetasMes) {
  const ultima = etiquetasVisibles.at(-1);
  if (!ultima || etiqueta.columna - ultima.columna >= SEPARACION_MINIMA) {
    etiquetasVisibles.push(etiqueta);
  }
}

const TAMANO_CELDA = 11;
const ESPACIO_CELDA = 3;
const PASO_COLUMNA = TAMANO_CELDA + ESPACIO_CELDA;

function clasePorNivel(nivel: number): string {
  if (nivel >= 4) return "bg-lima";
  if (nivel === 3) return "bg-lima/70";
  if (nivel === 2) return "bg-lima/45";
  if (nivel === 1) return "bg-lima/25";
  return "bg-[var(--linea)]";
}

const stats = [
  { valor: String(totalContribuciones), texto: t.github.contribuciones },
  { valor: `${rachaActual} ${t.github.dias}`, texto: t.github.rachaActual },
  { valor: `${rachaMaxima} ${t.github.dias}`, texto: t.github.rachaMaxima },
  { valor: String(repositoriosPublicos), texto: t.github.repositorios },
];
---

<section id="github" class="border-b border-[var(--linea)] py-24 md:py-32">
  <div class="contenedor">
    <header class="aparece max-w-xl">
      <p class="etiqueta text-humo">{t.github.eyebrow}</p>
      <h2 class="mt-5 text-titulo-sm text-escarcha md:text-titulo">{t.github.titulo}</h2>
      <p class="mt-5 max-w-lg text-cuerpo text-ceniza">{t.github.bajada}</p>
    </header>

    <div class="aparece mt-14 grid gap-10 rounded-2xl border border-[var(--linea)] bg-carbon p-8 md:grid-cols-[1.6fr_1fr] md:gap-12 md:p-12">
      <div class="min-w-0">
        <div class="scroll-fino overflow-x-auto pb-2">
          <div class="relative" style={`width: ${semanas.length * PASO_COLUMNA}px; padding-top: 1.5rem;`}>
            {
              etiquetasVisibles.map((etiqueta) => (
                <span class="etiqueta absolute top-0 text-pizarra" style={`left: ${etiqueta.columna * PASO_COLUMNA}px;`}>
                  {etiqueta.texto}
                </span>
              ))
            }

            <div class="grid grid-flow-col gap-[3px]" style="grid-template-rows: repeat(7, 11px);">
              {
                semanas.map((semana) =>
                  Array.from({ length: 7 }).map((_, fila) => {
                    const dia = semana[fila];
                    return dia ? (
                      <span
                        class={`block h-[11px] w-[11px] rounded-[2px] ${clasePorNivel(dia.nivel)}`}
                        title={`${dia.conteo} · ${dia.fecha}`}
                      />
                    ) : (
                      <span class="block h-[11px] w-[11px]" aria-hidden="true" />
                    );
                  })
                )
              }
            </div>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-end gap-2 text-leyenda text-pizarra">
          <span>{t.github.menos}</span>
          <span class="block h-[11px] w-[11px] rounded-[2px] bg-[var(--linea)]" aria-hidden="true" />
          <span class="block h-[11px] w-[11px] rounded-[2px] bg-lima/25" aria-hidden="true" />
          <span class="block h-[11px] w-[11px] rounded-[2px] bg-lima/45" aria-hidden="true" />
          <span class="block h-[11px] w-[11px] rounded-[2px] bg-lima/70" aria-hidden="true" />
          <span class="block h-[11px] w-[11px] rounded-[2px] bg-lima" aria-hidden="true" />
          <span>{t.github.mas}</span>
        </div>
      </div>

      <div class="flex flex-col justify-between gap-8 border-t border-[var(--linea)] pt-8 md:border-l md:border-t-0 md:pl-12 md:pt-0">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8">
          {
            stats.map((stat) => (
              <div>
                <dt class="cifra text-titulo-sm text-escarcha">{stat.valor}</dt>
                <dd class="mt-2 max-w-[18ch] text-leyenda leading-relaxed text-humo">{stat.texto}</dd>
              </div>
            ))
          }
        </dl>

        <div>
          <a
            href={SITIO.github}
            target="_blank"
            rel="noopener noreferrer"
            class="enlace-subrayado text-cuerpo text-ceniza hover:text-escarcha"
          >
            {t.github.verPerfil} →
          </a>
          <p class="mt-3 text-leyenda text-pizarra">{t.github.actualizado}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // En pantallas angostas el calendario no entra completo: arranca ya
  // desplazado al final (lo más reciente) en vez de mostrar los meses
  // más viejos por defecto.
  const scroller = document.querySelector<HTMLElement>("#github .scroll-fino");
  if (scroller) scroller.scrollLeft = scroller.scrollWidth;
</script>
