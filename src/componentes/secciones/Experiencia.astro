---
import AvionPuntos from "../islas/AvionPuntos.astro";
import type { Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);
---

<!-- La carrera como un grafo de git: un tronco y una rama por rol; las que
     siguen activas quedan en lima. El encabezado se queda fijo mientras la
     línea de tiempo pasa (solo en escritorio). -->
<section id="experiencia" class="border-b border-[var(--linea)] py-24 md:py-32">
  <div class="contenedor grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <header class="aparece lg:sticky lg:top-28 lg:self-start">
      <p class="etiqueta text-humo">{t.experiencia.eyebrow}</p>
      <h2 class="mt-5 text-titulo-sm text-escarcha md:text-titulo-lg">{t.experiencia.titulo}</h2>

      <div class="pointer-events-none relative mt-10 h-28 w-full max-w-xs lg:h-40">
        <AvionPuntos opacidad={0.7} />
      </div>
    </header>

    <div>
      <ol>
        {
          t.experiencia.lista.map((puesto) => (
            <li class:list={["rama__fila aparece", puesto.activo && "rama__fila--activa"]}>
              <div class="rama__grafo" aria-hidden="true">
                <svg class="rama__curva" viewBox="0 0 56 72" width="56" height="72">
                  <path d="M10.5 6 C10.5 30 40.5 20 40.5 46" />
                </svg>
                <span class="rama__punto" />
              </div>

              <div class="pb-14 pt-8">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <time class="cifra etiqueta text-pizarra">{puesto.periodo}</time>
                  {puesto.activo && (
                    <span class="etiqueta rounded-full border border-lima/40 px-2 py-0.5 text-[0.625rem] text-lima">
                      {t.experiencia.activo}
                    </span>
                  )}
                </p>
                <h3 class="mt-3 text-subtitulo text-escarcha md:text-titulo-sm">{puesto.rol}</h3>
                <p class="mt-2 text-cuerpo text-escarcha">
                  {puesto.empresa}
                  <span class="text-humo"> · {puesto.lugar}</span>
                </p>
                <p class="mt-3 max-w-2xl text-cuerpo text-ceniza">{puesto.detalle}</p>
                {"cita" in puesto && puesto.cita && (
                  <blockquote class="mt-6 max-w-xl border-l-2 border-lima/50 pl-5 text-subtitulo text-escarcha">
                    {puesto.cita}
                  </blockquote>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="aparece border-t border-[var(--linea)] pt-10">
        <p class="etiqueta text-humo">{t.formacion.eyebrow}</p>
        <p class="mt-4 max-w-3xl text-cuerpo text-ceniza">{t.formacion.texto}</p>
      </div>
    </div>
  </div>
</section>
