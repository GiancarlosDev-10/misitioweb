---
import LluviaCodigo from "../islas/LluviaCodigo.astro";
import { SITIO, type Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);

const enlaceWhatsapp = `${SITIO.whatsapp}?text=${encodeURIComponent(t.contacto.mensajeWhatsapp)}`;

const canales = [
  { etiqueta: t.contacto.email, valor: SITIO.email, href: `mailto:${SITIO.email}` },
  { etiqueta: t.contacto.telefono, valor: SITIO.telefono, href: `tel:${SITIO.telefonoEnlace}` },
  { etiqueta: t.contacto.linkedin, valor: "in/giancarlos-ormeno", href: SITIO.linkedin },
  { etiqueta: t.contacto.github, valor: "GiancarlosDev-10", href: SITIO.github },
];
---

<section id="contacto" class="relative overflow-hidden py-24 md:py-36">
  <LluviaCodigo opacidad={0.5} />
  <div class="luz-ambiente luz-ambiente--cierre" aria-hidden="true"></div>

  <div class="contenedor relative z-10">
    <div class="aparece">
      <p class="etiqueta text-humo">{t.contacto.eyebrow}</p>

      <!-- El cierre en neón es el CTA: todo el rótulo abre WhatsApp. -->
      <h2 class="mt-6">
        <a
          href={enlaceWhatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.contacto.neonAria}
          class="neon neon--cierre neon--al-ver"
        >
          {t.contacto.neon}
        </a>
      </h2>

      <p
        class="mt-10 max-w-2xl font-display text-subtitulo font-[330] leading-[1.2] tracking-[-0.015em] text-balance text-escarcha md:text-titulo-sm"
      >
        {t.contacto.titulo}
      </p>
      <p class="mt-5 max-w-xl text-cuerpo font-[400] text-ceniza">{t.contacto.bajada}</p>

      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={enlaceWhatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="etiqueta boton-lima inline-block rounded-none bg-lima px-6 py-3 text-vacio"
        >
          {t.contacto.cta}
        </a>
        <a href={SITIO.cv[idioma]} download class="enlace-subrayado text-cuerpo text-ceniza hover:text-escarcha">
          {t.hero.ctaCV}
        </a>
      </div>
    </div>

    <dl class="aparece mt-16 grid gap-px border-t border-[var(--linea)] md:grid-cols-4">
      {
        canales.map((canal) => (
          <div class="border-r border-[var(--linea)] pr-4 pt-6 last:border-r-0">
            <dt class="etiqueta text-pizarra">{canal.etiqueta}</dt>
            <dd class="mt-2">
              <a
                href={canal.href}
                target={canal.href.startsWith("http") ? "_blank" : undefined}
                rel={canal.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="enlace-subrayado text-cuerpo text-escarcha"
              >
                {canal.valor}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
