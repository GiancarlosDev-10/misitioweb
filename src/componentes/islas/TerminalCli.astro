---
/**
 * Terminal chica, tipo overlay — versión acotada de la idea de cris.fast.
 * No duplica contenido: lee los mismos datos que ya arman el resto del
 * sitio (SITIO + i18n), solo cambia la presentación. Comandos curados,
 * sin sistema de archivos falso ni contenido inventado.
 */
import { SITIO, type Idioma } from "../../datos/sitio";
import { contenido } from "../../i18n";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido(idioma);

const datos = {
  nombre: SITIO.nombre,
  // Wordmark del banner del CLI — versión corta y estilizada del dominio,
  // como "CRIS.FAST" en cris.fast. No es la URL real: es una marca.
  wordmark: "GIANCARLOS.DEV",
  eyebrow: t.hero.eyebrow,
  email: SITIO.email,
  telefono: SITIO.telefono,
  linkedin: SITIO.linkedin,
  github: SITIO.github,
  about: t.hero.bajada,
  experiencia: t.experiencia.lista.map((p) => ({
    empresa: p.empresa,
    rol: p.rol,
    periodo: p.periodo,
  })),
  proyectos: t.proyectos.lista.map((p) => ({
    titulo: p.titulo,
    resultado: p.resultado,
    urlVivo: p.urlVivo,
  })),
  textos: t.cli,
  prompt: t.cli.prompt,
};
---

<button
  type="button"
  id="cli-boton"
  aria-haspopup="dialog"
  aria-label={t.cli.abrir}
  class="cli-boton-glow fixed bottom-5 right-5 z-40 rounded-full border border-lima/60 bg-vacio/70 px-5 py-3 font-mono text-cuerpo text-lima backdrop-blur-md transition-colors duration-200 hover:text-escarcha"
>
  $ cli
</button>

<div
  id="cli-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Terminal"
  hidden
  class="fixed inset-0 z-50 flex items-end justify-center bg-vacio/60 p-0 backdrop-blur-md sm:items-center sm:p-6"
>
  <div class="flex h-[70svh] max-h-full w-full flex-col overflow-hidden border border-[var(--linea)] bg-vacio sm:h-[32rem] sm:max-w-2xl sm:rounded-2xl">
    <div class="flex items-center justify-between border-b border-[var(--linea)] px-4 py-3">
      <p class="font-mono text-cuerpo text-humo">{datos.prompt}</p>
      <button type="button" id="cli-cerrar" aria-label={t.cli.cerrar} class="text-humo transition-colors duration-200 hover:text-escarcha">
        ✕
      </button>
    </div>

    <div id="cli-salida" class="scroll-fino flex-1 space-y-2 overflow-y-auto whitespace-pre-wrap px-4 py-4 font-mono text-cuerpo text-lima/80"></div>

    <div class="flex items-center gap-2 border-t border-[var(--linea)] px-4 py-3">
      <span class="font-mono text-cuerpo text-lima">~$</span>
      <input
        id="cli-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        class="flex-1 bg-transparent font-mono text-cuerpo text-escarcha outline-none"
      />
      <span id="cli-cursor" class="cli-cursor h-4 w-2 bg-lima"></span>
    </div>
  </div>
</div>

<script type="application/json" id="cli-datos" set:html={JSON.stringify(datos).replace(/</g, "\\u003c")} is:inline />

<style>
  /* Resplandor lima alrededor del botón — mismo color de acento del sitio. */
  .cli-boton-glow {
    box-shadow:
      0 0 12px rgb(166 255 26 / 0.45),
      0 0 28px rgb(166 255 26 / 0.2);
  }

  .cli-cursor {
    animation: cli-parpadeo 1s step-start infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .cli-cursor {
      animation: none;
    }
  }

  @keyframes cli-parpadeo {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  interface DatosCli {
    nombre: string;
    wordmark: string;
    eyebrow: string;
    email: string;
    telefono: string;
    linkedin: string;
    github: string;
    about: string;
    experiencia: { empresa: string; rol: string; periodo: string }[];
    proyectos: { titulo: string; resultado: string; urlVivo: string }[];
    textos: {
      bienvenida: string;
      arranque: string;
      noEncontrado: string;
      sugerencia: string;
      ayuda: Record<string, string>;
      tituloExperiencia: string;
      tituloProyectos: string;
      verEnVivo: string;
      sudo: string;
    };
    prompt: string;
  }

  // Tiempo real desde que arrancó esta página hasta que este script corrió
  // — no un número inventado — para la línea de "boot" tipo cris.fast.
  const iniciadoEnMs = Math.round(performance.now());

  const boton = document.querySelector<HTMLButtonElement>("#cli-boton");
  const cerrar = document.querySelector<HTMLButtonElement>("#cli-cerrar");
  const overlay = document.querySelector<HTMLElement>("#cli-overlay");
  const salida = document.querySelector<HTMLElement>("#cli-salida");
  const input = document.querySelector<HTMLInputElement>("#cli-input");
  const bloqueDatos = document.querySelector<HTMLScriptElement>("#cli-datos");

  if (boton && cerrar && overlay && salida && input && bloqueDatos) {
    const datos = JSON.parse(bloqueDatos.textContent ?? "{}") as DatosCli;
    const historial: string[] = [];
    let indiceHistorial = -1;
    const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function linea(texto: string, clase = "") {
      const p = document.createElement("p");
      p.textContent = texto;
      if (clase) p.className = clase;
      salida!.appendChild(p);
    }

    /** Segmenta "texto **fuerte**" en partes planas y en negrita. */
    function segmentar(texto: string): { texto: string; enfasis: boolean }[] {
      return texto
        .split(/\*\*(.+?)\*\*/g)
        .filter((parte) => parte.length > 0)
        .map((parte, indice) => ({ texto: parte, enfasis: indice % 2 === 1 }));
    }

    function pintarSegmentos(p: HTMLParagraphElement, segmentos: { texto: string; enfasis: boolean }[], hasta: number) {
      p.textContent = "";
      let restante = hasta;
      for (const segmento of segmentos) {
        if (restante <= 0) break;
        const trozo = segmento.texto.slice(0, restante);
        if (segmento.enfasis) {
          const fuerte = document.createElement("strong");
          fuerte.className = "text-escarcha";
          fuerte.textContent = trozo;
          p.appendChild(fuerte);
        } else {
          p.appendChild(document.createTextNode(trozo));
        }
        restante -= trozo.length;
      }
    }

    /** Igual que linea(), pero interpreta "**negrita**" sin tipeo. */
    function lineaFormateada(texto: string, clase = "") {
      const segmentos = segmentar(texto);
      const p = document.createElement("p");
      if (clase) p.className = clase;
      salida!.appendChild(p);
      pintarSegmentos(p, segmentos, texto.length);
    }

    /** Efecto de tipeo: revela el texto letra por letra, respetando "**negrita**". */
    function escribirLinea(texto: string, alTerminar?: () => void) {
      const segmentos = segmentar(texto);
      const plano = segmentos.map((s) => s.texto).join("");
      const p = document.createElement("p");
      salida!.appendChild(p);

      if (reducido) {
        pintarSegmentos(p, segmentos, plano.length);
        alTerminar?.();
        return;
      }

      const paso = Math.max(1, Math.ceil(plano.length / 60));
      let i = 0;
      const id = window.setInterval(() => {
        i += paso;
        pintarSegmentos(p, segmentos, Math.min(i, plano.length));
        if (i >= plano.length) {
          window.clearInterval(id);
          alTerminar?.();
        }
      }, 16);
    }

    /** Distancia de Levenshtein, para sugerir el comando más parecido. */
    function distancia(a: string, b: string): number {
      const filas = a.length + 1;
      const columnas = b.length + 1;
      const matriz = Array.from({ length: filas }, (_, i) => {
        const fila = new Array<number>(columnas).fill(0);
        fila[0] = i;
        return fila;
      });
      for (let j = 0; j < columnas; j++) matriz[0]![j] = j;

      for (let i = 1; i < filas; i++) {
        for (let j = 1; j < columnas; j++) {
          const costo = a[i - 1] === b[j - 1] ? 0 : 1;
          matriz[i]![j] = Math.min(matriz[i - 1]![j]! + 1, matriz[i]![j - 1]! + 1, matriz[i - 1]![j - 1]! + costo);
        }
      }
      return matriz[filas - 1]![columnas - 1]!;
    }

    function sugerirComando(nombre: string, comandos: string[]): string | null {
      let mejor: string | null = null;
      let mejorDistancia = Infinity;
      for (const comando of comandos) {
        const d = distancia(nombre, comando);
        if (d < mejorDistancia) {
          mejorDistancia = d;
          mejor = comando;
        }
      }
      return mejor && mejorDistancia <= 2 ? mejor : null;
    }

    function enlace(texto: string, href: string) {
      const p = document.createElement("p");
      const a = document.createElement("a");
      a.href = href;
      a.textContent = texto;
      a.target = href.startsWith("http") ? "_blank" : "_self";
      a.rel = "noopener noreferrer";
      a.className = "text-lima underline underline-offset-4";
      p.appendChild(a);
      salida!.appendChild(p);
    }

    function espacio() {
      const p = document.createElement("p");
      p.innerHTML = "&nbsp;";
      salida!.appendChild(p);
    }

    const COMANDOS: Record<string, () => void> = {
      help: () => {
        for (const [comando, descripcion] of Object.entries(datos.textos.ayuda)) {
          linea(`${comando.padEnd(14, " ")}${descripcion}`);
        }
      },
      whoami: () => linea(`${datos.nombre} — ${datos.eyebrow}`),
      about: () => linea(datos.about),
      experience: () => {
        linea(datos.textos.tituloExperiencia, "text-escarcha");
        for (const puesto of datos.experiencia) {
          linea(`${puesto.empresa} — ${puesto.rol} (${puesto.periodo})`);
        }
      },
      projects: () => {
        linea(datos.textos.tituloProyectos, "text-escarcha");
        for (const proyecto of datos.proyectos) {
          linea(proyecto.titulo, "text-escarcha");
          linea(proyecto.resultado);
          if (proyecto.urlVivo) enlace(`→ ${datos.textos.verEnVivo}: ${proyecto.urlVivo}`, proyecto.urlVivo);
          espacio();
        }
      },
      contact: () => {
        linea(`email: ${datos.email}`);
        linea(`tel: ${datos.telefono}`);
        enlace(`linkedin: ${datos.linkedin}`, datos.linkedin);
        enlace(`github: ${datos.github}`, datos.github);
      },
      clear: () => {
        salida!.innerHTML = "";
      },
      exit: () => alternar(false),
      sudo: () => linea(datos.textos.sudo),
    };

    function ejecutar(comandoCrudo: string) {
      const comando = comandoCrudo.trim();
      if (!comando) return;

      linea(`~$ ${comando}`, "text-escarcha");
      historial.push(comando);
      indiceHistorial = historial.length;

      const nombre = comando.toLowerCase().split(/\s+/)[0] ?? "";
      const manejador = COMANDOS[nombre];
      if (manejador) {
        manejador();
      } else {
        linea(datos.textos.noEncontrado.replace("{0}", nombre));
        const sugerido = sugerirComando(nombre, Object.keys(COMANDOS));
        if (sugerido) lineaFormateada(datos.textos.sugerencia.replace(/\{0\}/g, sugerido));
      }
      salida!.scrollTop = salida!.scrollHeight;
    }

    // El teclado móvil reduce el visual viewport sin que las unidades
    // svh/dvh lo reflejen de forma confiable (Chrome Android en particular).
    // Se sincroniza el alto y el offset del overlay a mano para que no
    // quede recortado o "colapsado" detrás del teclado.
    function sincronizarViewport() {
      const vv = window.visualViewport;
      if (!vv || overlay!.hidden) return;
      overlay!.style.height = `${vv.height}px`;
      overlay!.style.top = `${vv.offsetTop}px`;
    }

    window.visualViewport?.addEventListener("resize", sincronizarViewport);
    window.visualViewport?.addEventListener("scroll", sincronizarViewport);

    // Sin esto, el body sigue siendo scrolleable detrás del overlay: al
    // enfocar el input, el navegador intenta hacer scroll a la página para
    // revelarlo y choca con el position:fixed — eso es lo que "colapsaba"
    // el overlay cuando aparecía el teclado.
    let scrollPrevio = 0;

    function bloquearScrollBody() {
      scrollPrevio = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollPrevio}px`;
      document.body.style.left = "0";
      document.body.style.right = "0";
    }

    function restaurarScrollBody() {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      // scroll-behavior: smooth es global — sin esto, restaurar la posición
      // se ve como un scroll animado hacia ahí en vez de quedarse quieto.
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo(0, scrollPrevio);
      document.documentElement.style.scrollBehavior = "";
    }

    function alternar(abrir: boolean) {
      overlay!.hidden = !abrir;
      if (abrir) {
        bloquearScrollBody();
        sincronizarViewport();
        if (!salida!.hasChildNodes()) {
          // Wordmark estática (no se tipea, aparece de una) + secuencia de
          // boot al estilo cris.fast: identidad, ubicación + tiempo real de
          // carga, línea en blanco, y por último los atajos.
          const banner = document.createElement("p");
          banner.className = "font-pixel text-titulo-sm leading-none tracking-normal text-lima sm:text-display sm:tracking-wide";
          banner.textContent = datos.wordmark;
          salida!.appendChild(banner);
          espacio();

          const [rol = "", ubicacion = ""] = datos.eyebrow.split(" · ");
          const lineaIdentidad = `**${datos.nombre}** — ${rol}`;
          const lineaUbicacion = `${ubicacion} · ${datos.textos.arranque.replace("{0}", String(iniciadoEnMs))}`;

          escribirLinea(lineaIdentidad, () => {
            escribirLinea(lineaUbicacion, () => {
              espacio();
              escribirLinea(datos.textos.bienvenida, espacio);
            });
          });
        }
        input!.focus();
      } else {
        overlay!.style.height = "";
        overlay!.style.top = "";
        restaurarScrollBody();
        // Diferido: si esto corre sincrónico dentro del keydown de Enter
        // (ej. al ejecutar "exit"), el foco pasa al botón ANTES del keyup
        // de esa misma tecla — el navegador interpreta ese keyup como un
        // Enter sobre un botón enfocado y le dispara un click, reabriendo
        // el overlay al toque. Con el foco corriendo en el siguiente tick,
        // el keyup ya se resolvió sobre el input, no sobre el botón.
        setTimeout(() => boton!.focus(), 0);
      }
    }

    boton.addEventListener("click", () => alternar(true));
    cerrar.addEventListener("click", () => alternar(false));
    overlay.addEventListener("click", (evento) => {
      if (evento.target === overlay) alternar(false);
    });

    document.addEventListener("keydown", (evento) => {
      const escribiendo = document.activeElement?.tagName === "INPUT" || document.activeElement?.tagName === "TEXTAREA";
      if (evento.key === "/" && !escribiendo && overlay!.hidden) {
        evento.preventDefault();
        alternar(true);
      } else if (evento.key === "Escape" && !overlay!.hidden) {
        alternar(false);
      }
    });

    input.addEventListener("keydown", (evento) => {
      if (evento.key === "Enter") {
        ejecutar(input!.value);
        input!.value = "";
      } else if (evento.key === "ArrowUp") {
        evento.preventDefault();
        if (indiceHistorial > 0) {
          indiceHistorial -= 1;
          input!.value = historial[indiceHistorial] ?? "";
        }
      } else if (evento.key === "ArrowDown") {
        evento.preventDefault();
        if (indiceHistorial < historial.length - 1) {
          indiceHistorial += 1;
          input!.value = historial[indiceHistorial] ?? "";
        } else {
          indiceHistorial = historial.length;
          input!.value = "";
        }
      } else if (evento.key === "Tab") {
        evento.preventDefault();
        const parcial = input!.value.toLowerCase();
        if (!parcial) return;
        const coincidencias = Object.keys(COMANDOS).filter((c) => c.startsWith(parcial));
        if (coincidencias.length === 1) input!.value = coincidencias[0]!;
      }
    });
  }
</script>
