---
/**
 * Silueta de F-16 (guiño a la Fuerza Aérea del Perú) renderizada como
 * puntos — extraída de una foto real con scripts/extraer-silueta.mjs
 * (sharp lee los píxeles, no es un trazo dibujado a mano). Cada punto
 * titila (shimmer) con fase propia — no hay traslación, solo brillo.
 */
import avionPuntos from "../../datos/avion-puntos.json";

interface Props {
  opacidad?: number;
}

const { opacidad = 1 } = Astro.props;
---

<canvas
  class="avion-puntos pointer-events-none absolute inset-0 h-full w-full"
  style={`opacity:${opacidad}`}
  aria-hidden="true"
></canvas>

<script type="application/json" class="avion-datos" set:html={JSON.stringify(avionPuntos).replace(/</g, "\\u003c")} is:inline />

<script>
  interface DatosSilueta {
    ancho: number;
    alto: number;
    puntos: [number, number][];
  }

  const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Misma silueta para todas las instancias del componente en la página:
  // basta con leer el primer bloque de datos.
  const bloqueDatos = document.querySelector<HTMLScriptElement>(".avion-datos");

  document.querySelectorAll<HTMLCanvasElement>("canvas.avion-puntos").forEach((lienzo) => {
    const contexto = lienzo.getContext("2d");
    if (!contexto || !bloqueDatos) return;

    const { ancho: ANCHO_TRAZO, alto: ALTO_TRAZO, puntos: crudos } = JSON.parse(bloqueDatos.textContent ?? "{}") as DatosSilueta;

    interface Punto {
      x: number;
      y: number;
      fase: number;
      radio: number;
    }

    let ancho = 0;
    let alto = 0;
    let puntos: Punto[] = [];

    // Seed propia: el shimmer cae siempre en el mismo patrón entre cargas.
    let semilla = 5;
    const azar = () => {
      semilla = (semilla * 1664525 + 1013904223) % 4294967296;
      return semilla / 4294967296;
    };

    function ubicarPuntos() {
      const escala = Math.min(ancho / ANCHO_TRAZO, alto / ALTO_TRAZO);
      const offsetX = (ancho - ANCHO_TRAZO * escala) / 2;
      const offsetY = (alto - ALTO_TRAZO * escala) / 2;

      puntos = crudos.map(([xn, yn]) => ({
        x: offsetX + xn * ANCHO_TRAZO * escala,
        y: offsetY + yn * ALTO_TRAZO * escala,
        fase: azar() * Math.PI * 2,
        radio: 0.9 + azar() * 1.1,
      }));
    }

    function redimensionar() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const caja = lienzo.getBoundingClientRect();
      ancho = caja.width;
      alto = caja.height;
      lienzo.width = Math.round(ancho * dpr);
      lienzo.height = Math.round(alto * dpr);
      contexto!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ubicarPuntos();
    }

    function dibujar(tiempo: number) {
      contexto!.clearRect(0, 0, ancho, alto);
      for (const punto of puntos) {
        const brillo = reducido ? 0.55 : 0.3 + 0.35 * (0.5 + 0.5 * Math.sin(tiempo * 0.0012 + punto.fase));
        contexto!.fillStyle = `rgba(255, 255, 255, ${brillo})`;
        contexto!.fillRect(punto.x - punto.radio / 2, punto.y - punto.radio / 2, punto.radio, punto.radio);
      }
    }

    redimensionar();
    window.addEventListener("resize", redimensionar);

    if (reducido) {
      dibujar(0);
      return;
    }

    let visible = false;
    let corriendo = false;
    function animar(tiempo: number) {
      dibujar(tiempo);
      corriendo = visible;
      if (visible) requestAnimationFrame(animar);
    }

    new IntersectionObserver(
      ([entrada]) => {
        visible = entrada?.isIntersecting ?? false;
        if (visible && !corriendo) {
          corriendo = true;
          requestAnimationFrame(animar);
        }
      },
      { threshold: 0 }
    ).observe(lienzo);
  });
</script>
