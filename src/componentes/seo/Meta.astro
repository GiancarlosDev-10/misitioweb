---
import { SITIO, LOCALES, IDIOMAS, rutaIdioma, type Idioma } from "../../datos/sitio";

interface Props {
  idioma: Idioma;
  titulo: string;
  descripcion: string;
  /** Ruta lógica sin prefijo de idioma, por ejemplo "/" o "/gracias". */
  ruta?: string;
  tituloOg?: string;
  noindex?: boolean;
}

const { idioma, titulo, descripcion, ruta = "/", tituloOg, noindex = false } = Astro.props;

/** Canonical siempre absoluto y sin barra final (salvo la raíz). */
function absoluta(camino: string): string {
  const limpio = camino === "/" ? "" : camino.replace(/\/+$/, "");
  return `${SITIO.url}${limpio || "/"}`;
}

const canonical = absoluta(rutaIdioma(idioma, ruta));
const imagenOg = new URL(SITIO.imagenOg, SITIO.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

{
  IDIOMAS.map((codigo) => (
    <link rel="alternate" hreflang={LOCALES[codigo]} href={absoluta(rutaIdioma(codigo, ruta))} />
  ))
}
<link rel="alternate" hreflang="x-default" href={absoluta(rutaIdioma("es", ruta))} />

<meta property="og:type" content="website" />
<meta property="og:title" content={tituloOg ?? titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITIO.nombre} />
<meta property="og:locale" content={idioma === "es" ? "es_PE" : "en_US"} />
<meta property="og:image" content={imagenOg} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITIO.nombre} — ${SITIO.rol}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloOg ?? titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenOg} />

<meta name="author" content={SITIO.nombre} />
<meta name="theme-color" content="#000000" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="preload" href="/fuentes/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fuentes/general-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
